{
    "name": "liry24-com",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "preview": "nuxt preview",
        "test": "bun test",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "cf:types": "bunx wrangler types .output/server/worker-configuration.d.ts --config .output/server/wrangler.json",
        "cimd-fetcher:types": "bunx wrangler types workers/cimd-fetcher/worker-configuration.d.ts --config workers/cimd-fetcher/wrangler.jsonc",
        "cimd-fetcher:typecheck": "bunx tsc --project workers/cimd-fetcher/tsconfig.json",
        "cimd-fetcher:deploy": "bunx wrangler deploy --config workers/cimd-fetcher/wrangler.jsonc",
        "post-publisher:types": "bunx wrangler types workers/post-publisher/worker-configuration.d.ts --config workers/post-publisher/wrangler.jsonc",
        "post-publisher:deploy": "bunx wrangler deploy --config workers/post-publisher/wrangler.jsonc",
        "db:generate": "bunx drizzle-kit generate",
        "db:sync:local": "bun scripts/sync-d1-to-local.ts",
        "db:verify:local": "bun scripts/verify-local-d1.ts .data/wrangler/state/v3",
        "db:migrate:local": "bun scripts/sync-d1-to-local.ts --migrate-only",
        "db:migrate:remote": "bunx wrangler d1 migrations apply liry24-com --remote --config .output/server/wrangler.json"
    },
    "dependencies": {
        "@ai-sdk/vue": "^4.0.55",
        "@aws-sdk/client-s3": "^3.1104.0",
        "@aws-sdk/lib-storage": "^3.1104.0",
        "@aws-sdk/s3-presigned-post": "^3.1104.0",
        "@aws-sdk/s3-request-presigner": "^3.1104.0",
        "@better-auth/cimd": "1.7.0-rc.4",
        "@better-auth/drizzle-adapter": "1.7.0-rc.4",
        "@better-auth/mcp": "1.7.0-rc.4",
        "@better-auth/passkey": "1.7.0-rc.4",
        "@cloudflare/containers": "^0.3.7",
        "@comark/nuxt": "0.6.1",
        "@iconify-json/mingcute": "^1.2.8",
        "@iconify-json/simple-icons": "^1.2.93",
        "@modelcontextprotocol/server": "2.0.0",
        "@nuxt/image": "^2.1.0",
        "@nuxt/ui": "^4.10.0",
        "@nuxtjs/sitemap": "8.3.3",
        "@takumi-rs/core": "2.5.10",
        "@takumi-rs/wasm": "2.5.10",
        "@vueuse/nuxt": "^14.4.0",
        "@yeger/vue-masonry-wall": "^6.1.4",
        "better-auth": "1.7.0-rc.4",
        "cnfast": "^0.1.0",
        "drizzle-orm": "1.0.0-rc.4",
        "fast-deep-equal": "^3.1.3",
        "files-sdk": "^2.2.3",
        "http-status-codes": "^2.3.0",
        "motion-v": "^2.3.0",
        "nanoid": "^6.0.1",
        "nuxt": "^4.5.2",
        "nuxt-og-image": "^6.7.6",
        "reflect-metadata": "^0.2.2",
        "sanitize-html": "^2.17.6",
        "workers-ai-provider": "^4.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260804.1",
        "@libsql/client": "^0.17.4",
        "@modelcontextprotocol/client": "2.0.0",
        "@nuxt/a11y": "^1.0.0-alpha.1",
        "@nuxt/hints": "^1.1.4",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.2",
        "@types/sanitize-html": "^2.16.1",
        "drizzle-kit": "1.0.0-rc.4",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^20.0.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.9",
        "wrangler": "^4.119.0"
    },
    "overrides": {
        "vue": "latest"
    },
    "packageManager": "bun@1.3.14"
}
