{
    "name": "liry24-com",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "admin:dev": "bun --filter=admin dev",
        "home:build": "bun install --frozen-lockfile --filter home --filter @repo/database && bun run --filter home build",
        "home:deploy": "bunx wrangler deploy --config apps/home/.output/server/wrangler.json",
        "admin:build": "bun install --frozen-lockfile --filter admin --filter @repo/database && bun run --filter admin build",
        "admin:deploy": "bunx wrangler deploy --config apps/admin/.output/server/wrangler.json"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260804.1",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.2",
        "kysely": "^0.29.4",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^20.0.0",
        "typescript": "^6.0.3",
        "wrangler": "^4.120.0"
    },
    "packageManager": "bun@1.3.14"
}
