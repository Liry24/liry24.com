{
    "name": "liry24-com",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "home:dev": "bun --filter=home dev",
        "admin:dev": "bun --filter=admin dev",
        "home:build": "bun install --frozen-lockfile --filter home --filter @repo/database && bun run --filter home build",
        "home:deploy": "bunx wrangler deploy --config apps/home/.output/server/wrangler.json",
        "admin:build": "bun install --frozen-lockfile --filter admin --filter @repo/database && bun run --filter admin build",
        "admin:deploy": "bunx wrangler deploy --config apps/admin/.output/server/wrangler.json",
        "test": "bun run test:unit && bun run test:worker",
        "test:unit": "bun run --filter admin test && bun run --filter home test",
        "test:worker": "vitest run --config vitest.worker.config.ts"
    },
    "devDependencies": {
        "@cloudflare/containers": "^0.3.7",
        "@cloudflare/vitest-pool-workers": "^0.20.3",
        "@cloudflare/workers-types": "^5.20260804.1",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^20.0.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "wrangler": "^4.120.0"
    },
    "packageManager": "bun@1.3.14"
}
