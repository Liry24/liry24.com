{
    "name": "liry24-com",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "dev": "dotenv -- bun run --filter './apps/*' dev",
        "build": "bun run typecheck && bun run --filter './packages/*' --filter './apps/*' build",
        "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
        "lint": "bun run --filter './packages/*' --filter './apps/*' lint",
        "lint:fix": "bun run --filter './packages/*' --filter './apps/*' lint:fix",
        "fmt": "bun run --filter './packages/*' --filter './apps/*' fmt",
        "fmt:check": "bun run --filter './packages/*' --filter './apps/*' fmt:check"
    },
    "devDependencies": {
        "@types/node": "^25.8.0",
        "dotenv-cli": "^11.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "oxfmt": "^0.50.0",
        "oxlint": "^1.65.0",
        "oxlint-tsgolint": "^0.22.1",
        "taze": "^19.12.0",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "vite": "^8.0.0",
        "vue": "latest"
    },
    "packageManager": "bun@1.3.14",
    "lint-staged": {
        "*.{ts,vue}": [
            "oxfmt --write",
            "oxlint --type-aware"
        ]
    }
}
