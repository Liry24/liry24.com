{
    "name": "liry24-com",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "bun run db:sync:local && nuxt dev",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "cf:types": "bunx wrangler types .output/server/worker-configuration.d.ts --config .output/server/wrangler.json",
        "db:generate": "bunx drizzle-kit generate",
        "db:sync:local": "bun scripts/sync-d1-to-local.ts",
        "db:verify:local": "bun scripts/verify-local-d1.ts .data/wrangler/state/v3",
        "db:migrate:local": "bun scripts/sync-d1-to-local.ts --migrate-only",
        "db:migrate:remote": "bunx wrangler d1 migrations apply liry24-com --remote --config .output/server/wrangler.json",
        "db:export:turso": "bun scripts/export-turso-for-d1.ts",
        "db:verify:migration": "bun scripts/verify-d1-migration.ts"
    },
    "dependencies": {
        "@ai-sdk/vue": "^4.0.42",
        "@better-auth/drizzle-adapter": "1.7.0-rc.2",
        "@better-auth/passkey": "1.7.0-rc.2",
        "@comark/nuxt": "0.5.1",
        "@iconify-json/mingcute": "^1.2.7",
        "@iconify-json/simple-icons": "^1.2.92",
        "@nuxt/image": "^2.1.0",
        "@nuxt/ui": "^4.10.0",
        "@nuxtjs/sitemap": "8.3.2",
        "@takumi-rs/core": "2.5.4",
        "@takumi-rs/wasm": "2.5.4",
        "@vueuse/nuxt": "^14.3.0",
        "@yeger/vue-masonry-wall": "^6.1.4",
        "aws4fetch": "^1.0.20",
        "better-auth": "1.7.0-rc.2",
        "clsx": "^2.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "fast-deep-equal": "^3.1.3",
        "files-sdk": "^2.2.2",
        "http-status-codes": "^2.3.0",
        "motion-v": "^2.3.0",
        "nanoid": "^6.0.0",
        "nuxt": "^4.5.1",
        "nuxt-og-image": "^6.7.5",
        "reflect-metadata": "^0.2.2",
        "sanitize-html": "^2.17.6",
        "workers-ai-provider": "^4.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260426.1",
        "@libsql/client": "^0.17.4",
        "@nuxt/a11y": "^1.0.0-alpha.1",
        "@nuxt/hints": "^1.1.4",
        "@types/node": "^26.1.2",
        "@types/sanitize-html": "^2.16.1",
        "drizzle-kit": "1.0.0-rc.4",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^19.16.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.8",
        "wrangler": "^4.115.0"
    },
    "overrides": {
        "vite": "^8.0.0",
        "vue": "latest"
    },
    "packageManager": "bun@1.3.14"
}
