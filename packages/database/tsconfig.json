{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "strict": true,
        "noImplicitAny": true,
        "strictFunctionTypes": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "declaration": true,
        "declarationMap": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
