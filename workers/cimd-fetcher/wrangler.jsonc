{
    "name": "liry24-cimd-fetcher",
    "main": "src/worker.ts",
    "compatibility_date": "2026-08-07",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": {
        "enabled": true,
    },
    "containers": [
        {
            "class_name": "CimdMetadataFetcher",
            "image": "./Dockerfile",
            "max_instances": 1,
            "instance_type": "lite",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "CIMD_METADATA_FETCHER",
                "class_name": "CimdMetadataFetcher",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["CimdMetadataFetcher"],
        },
    ],
}
