{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "liry24-post-publisher",
    "main": "worker.ts",
    "compatibility_date": "2026-07-30",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "liry24-com",
            "database_id": "227d818f-cd40-4fca-9710-b57273be94ca",
        },
    ],
    "workflows": [
        {
            "name": "liry24-post-publish-v1",
            "binding": "POST_PUBLISH_WORKFLOW",
            "class_name": "PublishPostWorkflow",
        },
    ],
    "observability": {
        "enabled": true,
    },
}
